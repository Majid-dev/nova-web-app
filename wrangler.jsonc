{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-web-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "5d431bb2-a42a-41a7-b053-cb758f97d5c4","database_name": "nova-d1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9de1f918539149b3ae97b3583359ec76" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
